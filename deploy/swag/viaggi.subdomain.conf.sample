## AMCrawler behind swag. Copy to /config/nginx/proxy-confs/viaggi.subdomain.conf
## (on Unraid: /mnt/user/appdata/swag/nginx/proxy-confs/) and restart swag.
## Access control is done by Cloudflare Access, not here.

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name viaggi.*;

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app amcrawler;
        set $upstream_port 8000;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
